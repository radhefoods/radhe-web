# Copy this file to `.env.local` and adjust. Nothing here is a secret:
# every NEXT_PUBLIC_ value is visible in the browser.

# The public address of this shop, without a slash at the end.
# Used for canonical URLs, hreflang, the sitemap and social cards.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# The Radhe Foods API, without a slash at the end and without /v1.
# Local development: the mock API (`npm run dev:mock`) or radhe-api, both on port 3000.
# Production: https://api.radhefoods.de
NEXT_PUBLIC_API_URL=http://localhost:3000

# Optional: the address the Next.js server itself uses to reach the API
# (for example an internal address on the same host). Defaults to NEXT_PUBLIC_API_URL.
API_INTERNAL_URL=

# Google sign-in: the OAuth client id (type "Web application"), the same one
# the API has as GOOGLE_CLIENT_ID. Leave empty to hide the Google button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Feature switches. "true" switches a feature on; anything else is off.
# WhatsApp opt-in in the account preferences (the API can already store it).
NEXT_PUBLIC_FEATURE_WHATSAPP=false

# Contact details shown in the footer and on error pages.
NEXT_PUBLIC_SUPPORT_EMAIL=hello@radhefoods.de
